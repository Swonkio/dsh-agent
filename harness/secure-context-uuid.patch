From 8e2fd201b42683420bc671bd9779362eb4284a8f Mon Sep 17 00:00:00 2001
From: agent <monerofan@tuta.io>
Date: Tue, 25 Aug 2026 16:47:51 +0000
Subject: [PATCH] replace SecureContext-gated crypto.randomUUID with
 getRandomValues helper
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

crypto.randomUUID is [SecureContext]-gated in browsers, so it is undefined
on a plain-HTTP origin that is not loopback — exactly the case when the
harness is served to a LAN address. mintRpcId and message identity then
throw in the web client. crypto.getRandomValues carries no such gate, so
the helper generates RFC 4122 v4 UUIDs on insecure origins and in Node.
---
 .../ui-conversation/src/client/random-uuid.ts | 19 +++++++++++++++++++
 .../ui-conversation/src/client/service.ts     |  3 ++-
 packages/host/apiproxy/src/fetch/client.ts    |  6 ++++--
 .../host/apiproxy/src/fetch/random-uuid.ts    | 19 +++++++++++++++++++
 packages/llm/llm/src/message.ts               |  3 ++-
 packages/llm/llm/src/random-uuid.ts           | 19 +++++++++++++++++++
 6 files changed, 65 insertions(+), 4 deletions(-)
 create mode 100644 packages/client/ui-conversation/src/client/random-uuid.ts
 create mode 100644 packages/host/apiproxy/src/fetch/random-uuid.ts
 create mode 100644 packages/llm/llm/src/random-uuid.ts

diff --git a/packages/client/ui-conversation/src/client/random-uuid.ts b/packages/client/ui-conversation/src/client/random-uuid.ts
new file mode 100644
index 0000000000..d99376a7e4
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/random-uuid.ts
@@ -0,0 +1,19 @@
+/** Secure-context-independent UUID generation for message identity. */
+
+/**
+ * Generate an RFC 4122 version 4 UUID without requiring a secure context.
+ *
+ * `crypto.randomUUID` is `[SecureContext]`-gated in browsers, so it is
+ * undefined on a plain-HTTP origin that is not loopback — exactly the case
+ * when the harness is served to a LAN address. `crypto.getRandomValues`
+ * carries no such gate.
+ * @returns a UUID backed by `crypto.getRandomValues()`, which browsers expose on insecure origins.
+ */
+export function randomUuid(): string {
+  const bytes = globalThis.crypto.getRandomValues(new Uint8Array(16))
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength)
+  view.setUint8(6, (view.getUint8(6) & 0x0f) | 0x40)
+  view.setUint8(8, (view.getUint8(8) & 0x3f) | 0x80)
+  const hex = Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('')
+  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`
+}
