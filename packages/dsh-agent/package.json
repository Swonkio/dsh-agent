{
  "name": "dsh-agent",
  "version": "0.1.0",
  "private": true,
  "description": "dsh-agent: an interactive terminal surface for DeepSeek Harness — a Claude Code-style CLI over the dsh-base plugin roster",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./startup": "./lib/startup.js",
